# The OpenAI key is read only by server.cjs and is never sent to the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Local teamserver management endpoint. Use an SSH tunnel for a remote server.
ABRAHAM_MGMT_ADDR=127.0.0.1:9000
ABRAHAM_MGMT_TOKEN=

ABRAHAM_WEB_HOST=127.0.0.1
ABRAHAM_WEB_PORT=4173
